{
  "version": 1,
  "features": {
    "quality_gate": {
      "enabled": true,
      "block_on_failed_test": true,
      "test_file_threshold": 3,
      "test_line_threshold": 100
    },
    "context_optimization": {
      "enabled": true,
      "read_line_threshold": 200,
      "max_file_size_bytes": 5242880
    },
    "evaluation_set_check": {
      "enabled": true
    }
  },
  "paths": {
    "state_dir": ".claude/state"
  }
}
