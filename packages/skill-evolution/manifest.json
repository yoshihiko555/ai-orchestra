{
  "name": "skill-evolution",
  "version": "0.2.0",
  "description": "スキル実行範囲の記録と、失敗の帰属・改善候補の台帳（コンテキスト注入なし）。core 依存",
  "depends": ["core"],
  "hooks": {
    "PreToolUse": [
      {
        "file": "inject-lessons.py",
        "matcher": "Skill",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "file": "capture-skill-telemetry.py",
        "matcher": "Skill",
        "timeout": 10
      }
    ],
    "SubagentStop": [
      {
        "file": "capture-subagent-skill.py",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "file": "capture-skill-stop.py",
        "timeout": 10
      }
    ],
    "UserPromptExpansion": [
      {
        "file": "record-skill-scope.py",
        "timeout": 10
      }
    ],
    "UserPromptSubmit": [
      {
        "file": "record-skill-scope.py",
        "timeout": 10
      }
    ],
    "SubagentStart": [
      {
        "file": "record-skill-scope.py",
        "timeout": 10
      }
    ]
  },
  "files": [
    "hooks/inject-lessons.py",
    "hooks/capture-skill-telemetry.py",
    "hooks/capture-subagent-skill.py",
    "hooks/capture-skill-stop.py",
    "hooks/record-skill-scope.py",
    "lib/candidates_safety.py",
    "lib/candidates_runs.py",
    "lib/candidates_model.py",
    "lib/candidates_store.py",
    "lib/candidates_ingest.py",
    "lib/candidates_view.py",
    "lib/candidates_cli.py",
    "lib/candidates_git.py",
    "lib/candidates_handoff.py",
    "lib/candidates_handoff_events.py",
    "lib/candidates_recurrence.py",
    "lib/candidates_schema.py",
    "lib/candidates_checks.py",
    "lib/candidates_draft.py",
    "lib/candidates_scenario_events.py",
    "lib/candidates_scenarios.py",
    "lib/skill_evolution_common.py"
  ],
  "skills": ["skill-candidates"],
  "agents": [],
  "rules": [],
  "scripts": [
    {
      "path": "scripts/skill_evolution.py",
      "description": "v1 互換 CLI（非推奨）: status / check-trigger / evaluate / provenance / lock"
    },
    {
      "path": "scripts/skill_candidates.py",
      "description": "改善候補の一覧・詳細・実行範囲（読み取り。許可リストに入れてよい）"
    },
    {
      "path": "scripts/skill_candidates_admin.py",
      "description": "証拠の取り込み・帰属・改善候補の操作（人の承認が必要。許可リストに入れない）"
    }
  ],
  "config": ["config/skill-evolution.yaml"]
}
