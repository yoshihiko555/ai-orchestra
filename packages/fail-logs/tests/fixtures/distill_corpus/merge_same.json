      ],
      [
        "bash",
        "python3 -m pip install pyyaml",
        { "error": "Exit code 1\nerror: externally-managed-environment" }
      ],
      ["user", "システムの Python に入れようとしないで。uv add を使って"],
      ["bash", "uv add pyyaml", { "output": "Added pyyaml" }],
