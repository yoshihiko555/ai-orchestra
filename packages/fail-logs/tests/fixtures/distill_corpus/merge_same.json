        "title": "グローバルの Python に pip install せず uv でプロジェクトの .venv に入れる",
        "scope": "all"
      },
      { "id": "L-00000042", "title": "main に直接 push しない", "scope": "all" }
    ],
    "turns": [
      ["user", "yaml を読むライブラリを入れて"],
      [
        "bash",
        "pip3 install pyyaml",
