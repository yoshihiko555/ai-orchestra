[
  {
    "id": "tdd-01",
    "expect": { "signal": false, "lesson": false },
    "turns": [
      ["user", "TDD で add 関数を作って"],
      [
        "tool",
        "Write",
        {
          "file_path": "tests/test_math.py",
          "content": "def test_add():\n    assert add(1, 2) == 3\n"
        },
        { "output": "ok" }
      ],
      [
        "bash",
        "pytest -q tests/test_math.py",
        {
          "error": "Exit code 1\nE NameError: name 'add' is not defined\n1 failed"
        }
      ],
      [
        "tool",
        "Write",
        {
          "file_path": "src/math.py",
          "content": "def add(a, b):\n    return a + b\n"
        },
        { "output": "ok" }
      ],
      ["bash", "pytest -q tests/test_math.py", { "output": "1 passed" }],
      ["assistant", "red → green で add を実装しました"]
    ]
  },
  {
