    "turns": [
      ["user", "README に使い方の節を足して"],
      ["tool", "Read", { "file_path": "README.md" }, { "output": "# App" }],
      [
        "tool",
        "Edit",
        {
          "file_path": "README.md",
          "old_string": "# App",
          "new_string": "# App\n\n## 使い方\n\n`app run`"
        },
        { "output": "ok" }
      ],
      ["assistant", "使い方の節を足しました"],
      ["user", "ありがとう"]
    ]
  },
  {
    "id": "benign-02",
    "expect": { "signal": false, "lesson": false },
