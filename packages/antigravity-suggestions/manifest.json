{
  "name": "antigravity-suggestions",
  "version": "0.2.0",
  "description": "Web 検索・fetch 時の Antigravity リサーチ提案",
  "depends": ["core"],
  "hooks": {
    "PreToolUse": [
      {
        "file": "suggest-antigravity-research.py",
        "matcher": "WebSearch|WebFetch"
      }
    ]
  },
  "files": ["hooks/suggest-antigravity-research.py"],
  "skills": ["gemini-system"],
  "agents": [],
  "rules": ["gemini-delegation", "gemini-suggestion-compliance"],
  "scripts": [],
  "config": [],
  "context_files": {
    "source": "gemini.md",
    "template": "templates/gemini/GEMINI.md",
    "init": [
      ".gemini/GEMINI.md",
      ".gemini/settings.json",
      ".gemini/skills/context-loader/"
    ],
    "sync": [".gemini/GEMINI.md"]
  }
}
