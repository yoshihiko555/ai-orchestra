{
  "name": "codd",
  "version": "0.3.0",
  "description": "CODD 整合性レイヤー（ドキュメント依存グラフの scan / validate / impact + コード⇔ドキュメントのトレーサビリティ。core 依存）",
  "depends": ["core"],
  "hooks": {
    "PreToolUse": [{ "file": "codd-validate-precommit.py", "matcher": "Bash" }],
    "PostToolUse": [{ "file": "codd-scan-postedit.py", "matcher": "Edit|Write" }]
  },
  "files": ["hooks/codd-scan-postedit.py", "hooks/codd-validate-precommit.py"],
  "skills": ["codd-scan", "codd-validate", "codd-impact"],
  "agents": [],
  "rules": ["codd-frontmatter-policy"],
  "scripts": [
    {
      "path": "scripts/codd.py",
      "description": "CODD CLI: scan（依存グラフ構築）/ validate（整合性検証）/ graph（可視化）/ impact（変更影響の信頼度分類）"
    }
  ],
  "config": ["config/codd.yaml"]
}
